APP_NAME=Phish-Hunter-k4
APP_ENV=dev
HOST=127.0.0.1
PORT=8000
SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
DATABASE_URL=sqlite:///./data/phishhunter.db
STORAGE_DIR=./data/storage
MAX_UPLOAD_MB=25
MAX_EMAIL_ATTACHMENT_MB=8
MAX_NESTED_ARCHIVE_DEPTH=3
MAX_ARCHIVE_FILES=2000
PUBLIC_BASE_URL=http://127.0.0.1:8000
ALLOWED_HOSTS=127.0.0.1,localhost
VERIFY_DNS=true
FETCH_TIMEOUT_SECONDS=12
MAX_REDIRECTS=8
COOKIE_SECURE=false
CSRF_COOKIE_NAME=phishhunter_csrf
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=120
AUTH_RATE_LIMIT_MAX_REQUESTS=12
ANALYSIS_RATE_LIMIT_MAX_REQUESTS=24
ENABLE_EXTERNAL_TI=false
VIRUSTOTAL_API_KEY=
URLSCAN_API_KEY=
ABUSEIPDB_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
SANDBOX_ENABLED=false
SANDBOX_BACKEND=disabled
SANDBOX_ENDPOINT=
ADMIN_HOST=127.0.0.1
ADMIN_PORT=8000

HIBP_API_KEY=
GOOGLE_SAFE_BROWSING_API_KEY=
DNSDUMPSTER_API_KEY=

# URL & Domain deep enrichment
WAPPALYZER_API_KEY=
LINKEDIN_ACCESS_TOKEN=
