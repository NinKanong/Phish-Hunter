# Local defaults
APP_ENV=dev
DATABASE_URL=sqlite:///./data/phishhunter.db
STORAGE_DIR=./data/storage
PUBLIC_BASE_URL=http://127.0.0.1:8000
SECRET_KEY=replace-with-a-long-random-secret
COOKIE_SECURE=false

# Production PostgreSQL example
# DATABASE_URL=postgresql+psycopg://k4:password@localhost:5432/k4

# Optional infrastructure endpoints for future adapters
REDIS_URL=redis://127.0.0.1:6379/0
S3_ENDPOINT=http://127.0.0.1:9000
S3_BUCKET=k4-evidence
OPENSEARCH_URL=http://127.0.0.1:9200

HIBP_API_KEY=
GOOGLE_SAFE_BROWSING_API_KEY=
DNSDUMPSTER_API_KEY=

# URL & Domain deep enrichment
WAPPALYZER_API_KEY=
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_ORGANIZATION_ID=
LINKEDIN_VERSION=202610

PHISHHUNTER_IPINFO_API_KEY=

PHISHHUNTER_SECURITYTRAILS_API_KEY=
PHISHHUNTER_DOMAINTOOLS_API_KEY=
